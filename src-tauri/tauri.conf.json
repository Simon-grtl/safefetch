{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SafeFetch",
  "version": "0.1.0",
  "identifier": "io.github.safefetch.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SafeFetch",
        "width": 1100,
        "height": 780,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm", "msi", "nsis", "dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Download, quarantine and scan files before they reach your folders.",
    "longDescription": "SafeFetch downloads files into a quarantine folder, checks them with VirusTotal (hash/URL only), ClamAV and Microsoft Defender, and only delivers files judged clean.",
    "license": "MIT",
    "linux": {
      "deb": { "depends": [] }
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2MDM2RTc0NkJDRThCODAKUldTQWk4NXJkRzREcGpqa01DVFlocHZWT3lGWEdqTWN3MUdYdXVsS2FkUWFHaFo0cGdadlpLc3cK",
      "endpoints": ["https://github.com/Simon-grtl/safefetch/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
